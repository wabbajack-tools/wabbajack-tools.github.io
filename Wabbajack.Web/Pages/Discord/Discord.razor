@page "/discord"
@inject NavigationManager Navmanger

<div class="font-title flex-grow justify-center items-center text-center">
    <h1 class="justify-center items-center text-center">Discord Redirect Page</h1>

    <p class="justify-center items-center text-center">Redirecting to discord invite.</p>
</div>


@code {
    public const string Route = "/discord";

    protected override void OnInitialized()
    {
        Navmanger.NavigateTo("https://discord.com/invite/G9ybsAeH7B");
    }
}
